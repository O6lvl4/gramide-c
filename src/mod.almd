import gramide.package_api
import self.lexer
import self.symbols
import self.table
let VERSION = "0.1.0"
fn definition() -> package_api.Definition = package_api.Definition {
  id: "c", package_name: "gramide-c", version: VERSION, extensions: [".c", ".h"],
  capabilities: ["tokens", "parse", "outline", "symbols", "tags", "map"],
  lexer: () => (source, recovering) => lexer.scan(source, recovering), grammar: () => table.compiled(), sep: ".", symbols: symbols.symbol_rules()
}
