// A source-preserving C scanner. Directives are opaque comment-kind tokens:
// their text and ranges are retained, but no macro expansion is claimed.
import gramide.tree
import gramide.lex

let KEYWORDS = ["auto", "break", "case", "char", "const", "continue", "default", "do", "double", "else", "enum", "extern", "float", "for", "goto", "if", "inline", "int", "long", "register", "restrict", "return", "short", "signed", "sizeof", "static", "struct", "switch", "typedef", "union", "unsigned", "void", "volatile", "while", "_Alignas", "_Alignof", "_Atomic", "_Bool", "_Complex", "_Generic", "_Noreturn", "_Static_assert", "_Thread_local"]
let OPERATORS = [">>=", "<<=", "...", "->", "++", "--", "<<", ">>", "<=", ">=", "==", "!=", "&&", "||", "*=", "/=", "%=", "+=", "-=", "&=", "^=", "|=", "{", "}", "[", "]", "(", ")", ";", ",", ".", ":", "?", "~", "!", "+", "-", "*", "/", "%", "<", ">", "=", "&", "^", "|"]
fn byte(src: Bytes, i: Int) -> Int = bytes.get_or(src, i, -1)
fn digit(b: Int) -> Bool = b >= 48 and b <= 57
fn letter(b: Int) -> Bool = (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95 or b >= 128
fn word(b: Int) -> Bool = letter(b) or digit(b)
fn text(src: Bytes, s: Int, e: Int) -> String = bytes.to_string_lossy(bytes.slice(src, s, e))
fn token(kind: Int, s: Int, e: Int, line: Int, line_start: Int) -> tree.Token = tree.Token { kind: kind, start: s, end: e, line: line, col: s - line_start + 1 }
fn matches(src: Bytes, at: Int, op: String) -> Bool = {
  let bs = bytes.from_string(op)
  var j = 0
  var same = true
  while same and j < bytes.len(bs) {
    if byte(src, at + j) != byte(bs, j) then same = false else j = j + 1
  }
  same
}

// gramide v0.2.11 reports LF-based line coordinates. Refuse lone CR
// rather than exporting a complete symbol with an inconsistent end line.
fn source_line_endings(source: Bytes) -> Result[Unit, lex.LexError] = {
  var i = 0
  var line = 1
  var base = 0
  while i < bytes.len(source) {
    guard bytes.get_or(source, i, -1) != 13 or bytes.get_or(source, i + 1, -1) == 10 else
      err(lex.LexError { line: line, col: i - base + 1, message: "core reader supports LF or CRLF line endings, not lone CR" })
    if bytes.get_or(source, i, -1) == 10 then { line = line + 1; base = i + 1 } else ()
    i = i + 1
  }
  ok(())
}

fn scan(source: String, recovering: Bool) -> Result[List[tree.Token], lex.LexError] = {
  let src = bytes.from_string(source)
  if not recovering then source_line_endings(src)! else ()
  let n = bytes.len(src)
  var out: List[tree.Token] = []
  var i = 0
  var line = 1
  var line_start = 0
  var line_head = true
  while i < n {
    let b = byte(src, i)
    if b == 32 or b == 9 or b == 13 then i = i + 1
    else if b == 10 then { i = i + 1; line = line + 1; line_start = i; line_head = true }
    else {
      let start = i
      let start_line = line
      let start_base = line_start
      var kind = tree.T_NONE
      var failure = ""
      if b == 47 and byte(src, i + 1) == 47 then {
        i = i + 2
        while i < n and byte(src, i) != 10 { i = i + 1 }
      } else if b == 47 and byte(src, i + 1) == 42 then {
        i = i + 2
        while i < n and not (byte(src, i) == 42 and byte(src, i + 1) == 47) { i = i + 1 }
        if i == n then failure = "unterminated C comment" else i = i + 2
      } else if b == 35 and line_head then {
        kind = tree.T_COMMENT
        i = i + 1
        var continuing = true
        while i < n and continuing {
          if byte(src, i) == 10 then {
            if byte(src, i - 1) == 92 or (byte(src, i - 1) == 13 and byte(src, i - 2) == 92) then i = i + 1
            else continuing = false
          } else i = i + 1
        }
      } else {
        line_head = false
        let prefix = if (b == 76 or b == 117 or b == 85) and (byte(src, i + 1) == 34 or byte(src, i + 1) == 39) then 1
          else if b == 117 and byte(src, i + 1) == 56 and byte(src, i + 2) == 34 then 2 else 0
        let q = byte(src, i + prefix)
        if q == 34 or q == 39 then {
          kind = if q == 34 then tree.T_STRING else tree.T_RUNE
          i = i + prefix + 1
          var closed = false
          while i < n and not closed and failure == "" {
            if byte(src, i) == q then { i = i + 1; closed = true }
            else if byte(src, i) == 10 or byte(src, i) == 13 then failure = "newline in C literal"
            else if byte(src, i) == 92 then {
              i = i + 1
              if byte(src, i) == 13 and byte(src, i + 1) == 10 then i = i + 2
              else if i < n then i = i + 1 else ()
            } else i = i + 1
          }
          if not closed and failure == "" then failure = "unterminated C literal" else ()
        } else if letter(b) then {
          i = i + 1
          while word(byte(src, i)) { i = i + 1 }
          kind = if list.contains(KEYWORDS, text(src, start, i)) then tree.T_KEYWORD else tree.T_IDENTIFIER
        } else if digit(b) or (b == 46 and digit(byte(src, i + 1))) then {
          // Preprocessing-number shape, including C suffixes and hex floats.
          // Semantic validation belongs to the C compiler; this is a reader.
          kind = tree.T_NUMBER
          i = i + 1
          while word(byte(src, i)) or byte(src, i) == 46 or
            ((byte(src, i) == 43 or byte(src, i) == 45) and list.contains([101, 69, 112, 80], byte(src, i - 1))) { i = i + 1 }
        } else {
          var width = 0
          for op in OPERATORS {
            if width == 0 and matches(src, i, op) then width = string.len(op) else ()
          }
          if width == 0 then { i = i + 1; failure = "unexpected byte in C source" }
          else { kind = tree.T_PUNCT; i = i + width }
        }
      }
      if failure != "" then {
        guard recovering else err(lex.LexError { line: start_line, col: start - start_base + 1, message: failure })
        kind = tree.T_ERROR
      } else ()
      if kind != tree.T_NONE then list.push(out, token(kind, start, i, start_line, start_base)) else ()
      var pos = start
      while pos < i {
        if byte(src, pos) == 10 then { line = line + 1; line_start = pos + 1; line_head = true } else ()
        pos = pos + 1
      }
      if kind != tree.T_NONE then line_head = false else ()
    }
  }
  list.push(out, token(tree.T_EOF, n, n, line, line_start))
  ok(out)
}

test "C strings comments and directives keep byte positions" {
  let src = "/* 日本語 */\n#define N 2\\\n + 1\nint café(void) { return N; }"
  let toks = scan(src, false) |> result.map_err((e) => e.message)!
  let directive = list.first(toks)!
  assert_eq(directive.kind, tree.T_COMMENT)
  assert_eq(directive.line, 2)
  assert_eq(tree.token_text(bytes.from_string(src), directive), "#define N 2\\\n + 1")
  let name = list.get(toks, 2)!
  assert_eq(tree.token_text(bytes.from_string(src), name), "café")
  assert_eq(name.line, 4)
  assert_eq(name.col, 5)
  assert(result.is_err(scan("char *s = \"unterminated", false)))
  assert(result.is_err(scan("/* unterminated", false)))
  assert(result.is_ok(scan("/* unterminated", true)))
}

test "core readers keep LF and CRLF ranges and reject lone CR" {
  assert(result.is_err(scan("/* one\rtwo */", false)))
  assert(result.is_err(scan("\r", false)))
  assert(result.is_ok(scan("\r\n", false)))
}
